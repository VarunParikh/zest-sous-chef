# Zest configuration. Copy to `.env` (git-ignored) and edit there only.
# Never put a real key in this file, in code, docs, commits or chat.

# Text model (ADR-002, accepted 2026-10-18 from the Day-1 benchmark E1)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
# Context window in tokens (E1 post-hoc change: 4096 instead of Ollama's 16384 to save memory)
LLM_NUM_CTX=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Input guard (ADR-006, accepted 2026-10-18 from E4): rules first, then the classifier on text they pass.
# If the classifier is unreachable the rules result stands.
GUARD_CLASSIFIER=true
GUARD_MODEL=llama-guard3:1b
# ADR-006 v3 (C40, C44): classifier categories that do not block (S8 = Intellectual Property, S6 = Specialized Advice);
# empty to block on all
GUARD_IGNORE_CATEGORIES=S6
GUARD_IGNORE_IF_LINK=S8

# Intent classifier (Agent Design §6.1): below this confidence Zest asks the user to rephrase
INTENT_CONFIDENCE_MIN=0.5

# Photo analysis (ADR-003 v3, owner decision 2026-10-18): default the local qwen3-vl:4b-instruct through Ollama
# (it failed E3; photo accuracy NOT MET; detections are estimates confirmed before the cart changes).
# Opt-in: VISION_PROVIDER=gemini and VISION_MODEL=gemini-3.5-flash-lite in your local .env, with GEMINI_API_KEY there.
# Sample photos (VISION_PROVIDER=samples) are the demo path and the fallback.
VISION_PROVIDER=ollama
VISION_MODEL=qwen3-vl:4b-instruct
# Context window for the local vision model (tokens)
VISION_NUM_CTX=4096
# Optional. Only used when VISION_PROVIDER=gemini. Leave blank here.
GEMINI_API_KEY=

# Embedder (ADR-005): empty model means Chroma's default ONNX embedder
EMBEDDING_PROVIDER=chroma_default
EMBEDDING_MODEL=

# Retrieval (ADR-004 v2): hybrid | lexical (rollback, FR-117)
RETRIEVAL_MODE=hybrid
RRF_K=60
DISH_POOL=25
VARIANT_POOL=10
AMBIGUITY_MARGIN=0.15
ADDON_COURSES=side,beverage,dessert
ADDON_WEIGHTS=curated:2,vector:1
ADDON_POOL=12

# Variant scoring (ADR-008)
VALUE_WEIGHT=0.20

# Timeouts in seconds (NFR-10)
TIMEOUT_LLM_S=30
TIMEOUT_VISION_S=60
TIMEOUT_TRANSCRIPT_S=10

# Transcripts and recipe text (C39): live YouTube transcript fetch on or off; text cap for the 4k context
LIVE_TRANSCRIPTS=true
MAX_RECIPE_CHARS=6000

# Photo detection
CONFIDENCE_THRESHOLD=0.6

# Reproducible context: blank means system clock and the mock weather label
CONTEXT_NOW=
CONTEXT_WEATHER=

# Demo endpoints (S-09): off by default
DEMO_CONTROLS=false

# Local, git-ignored storage
TRACE_PATH=logs/trace.jsonl
CHROMA_PATH=data/chroma
